    "@eslint/js": "^9.18.0",
    "@tsconfig/node23": "^23.0.0",
    "@types/node": "^22.10.7",
    "eslint": "^9.18.0",
    "prettier": "^3.5.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.21.0"
  },
  "engines": {
    "node": "^23.0.0"
  },
  "dependencies": {
    "@effect/experimental": "^0.57.0",
    "@effect/language-service": "^0.55.2",
    "@effect/opentelemetry": "^0.59.0",
    "@effect/platform": "^0.93.0",
    "@effect/platform-node": "^0.100.0",
    "@effect/platform-node-shared": "^0.53.0",
    "@effect/rpc": "^0.72.1",
    "@effect/sql": "^0.48.0",
    "@effect/workflow": "^0.12.2",
    "@opentelemetry/sdk-metrics": "^2.2.0",
    "@opentelemetry/sdk-trace-node": "^2.2.0",
    "@opentelemetry/sdk-trace-web": "^2.2.0",
    "@xmldom/xmldom": "^0.9.8",
    "effect": "^3.19.3",
    "ical-generator": "^8.1.1",
